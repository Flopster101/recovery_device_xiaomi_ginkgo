From dca51f393f0bc0099c831740b859ff49144dae7f Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Fri, 8 May 2026 19:50:54 -0300
Subject: [PATCH 2/2] recovery: gui: Turn on with KEY_WAKEUP

Commonly used by touch panels to signal a DT2W gesture.

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
---
 gui/gui.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/gui/gui.cpp b/gui/gui.cpp
index 1f13ee2f..8b858dc9 100644
--- a/gui/gui.cpp
+++ b/gui/gui.cpp
@@ -368,6 +368,13 @@ void InputHandler::process_EV_KEY(input_event& ev)
 
 	// Handle key-press here
 	LOGEVENT("TOUCH_KEY: %d\n", ev.code);
+	if (ev.code == KEY_WAKEUP) {
+		if (ev.value == 0 && blankTimer.isScreenOff())
+			blankTimer.resetTimerAndUnblank();
+		key_status = KS_NONE;
+		touch_status = TS_NONE;
+		return;
+	}
 	// Left mouse button is treated as a touch
 	if (ev.code == BTN_LEFT)
 	{
-- 
